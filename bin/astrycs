#!/usr/bin/env sh
# astrycs — a tiny, dependency-free helper toolkit.
set -eu

usage() {
    cat <<'EOF'
astrycs <command> [args]

Commands:
  echo <text>    Print text back.
  upper <text>   Print text in upper case.
  repeat N TEXT  Print TEXT N times.
  lower <text>   Print text in lower case.
  len <text>    Print the length of the text.
  trim <text>   Trim surrounding whitespace.
  join <sep> [text...]  Join the remaining arguments with <sep>.
  slug <text>   Convert text into a url slug.
  pad <width> <text>  Left-pad text with spaces up to width.
  reverse <text>  Reverse the text.
  strip <chars> <text>  Delete the given characters from the text.
  title <text>   Capitalize the first letter of each word.
  nospace <text>  Collapse whitespace runs into single spaces.
  wrap <width> <text>  Wrap text to <width> columns.
  indent <n> <text>  Indent every line by <n> spaces.
  words <text>   Count the words in the text.
  lines <text>   Count the lines in the text.
  head <n> <text>  Print only the first <n> lines.
  tail <n> <text>  Print only the last <n> lines.
  unique <text>  Sort the lines and drop duplicates.
  sortlines <text>  Sort the lines alphabetically.
  csv-join <sep> [text...]  Join arguments as csv cells.
  replace <find> <with> <text>  Replace every occurrence of <find>.
  camel <text>   Convert text to camelCase.
  kebab <text>   Convert text to kebab-case.
  snake <text>   Convert text to snake_case.
  capitalize <text>  Upper-case the first letter only.
  swapcase <text>  Swap the case of every letter.
  initials <text>  Extract the initials of each word.
  starts-with <prefix> <text>  Test a prefix.
  ends-with <suffix> <text>  Test a suffix.
  contains <needle> <text>  Test for a substring.
  is-empty <text>  Report whether the text is empty.
Examples:
  $ astrycs slug "Hello, World!"
  $ astrycs pad 10 total
  $ astrycs title "hello world"

  is-number <text>  Report whether the text is numeric.
  split <sep> <text>  Split text on a separator, one per line.
  default <fallback> <text>  Fall back when the text is empty.
  take <n> <text>  Keep the first <n> words.
  drop <n> <text>  Discard the first <n> words.
  reverse-words <text>  Reverse the order of the words.
  unique-words <text>  Sort and deduplicate the words.
  count-char <char> <text>  Count occurrences of a character.
  sum [numbers...]  Add the given numbers.
  max [numbers...]  Print the largest number.
  min [numbers...]  Print the smallest number.
  abs <n>  Print the absolute value of a number.
  round <n>  Round a number to the nearest integer.
  even <n>  Report whether a number is even.
  odd <n>  Report whether a number is odd.
  ordinal <n>  Render a number as an ordinal (1st, 2nd, 3rd).
  pluralize <count> <singular> [plural]  Pick the right plural form.
  center <width> <text>  Center text within a width.
  truncate <width> <text>  Shorten text to a width.
  mask <keep> <text>  Mask the middle of a string.
  squeeze <text>  Collapse runs of repeated characters.
  urlencode <text>  Percent-encode reserved characters.
  number-lines <text>  Prefix each line with its number.
  bullet [marker] <text>  Prefix each line with a bullet.
  dedent <text>  Strip leading whitespace from every line.
  indent-right <n> <text>  Indent every line on the right.
  chunk <size> <text>  Break text into fixed-size chunks.
  help           Show this message.
EOF
}

cmd="${1:-help}"
if [ $# -gt 0 ]; then shift; fi

case "$cmd" in
    echo)
        printf '%s\n' "$*"
        ;;
    upper)
        printf '%s\n' "$*" | tr '[:lower:]' '[:upper:]'
        ;;
    repeat)
        n="${1:-1}"
        shift || true
        i=0
        while [ "$i" -lt "$n" ]; do
            printf '%s\n' "$*"
            i=$((i + 1))
        done
        ;;
    lower)
        printf '%s\n' "$*" | tr '[:upper:]' '[:lower:]'
        ;;
    len)
        t="$*"
        printf '%s\n' "${#t}"
        ;;
    trim)
        t="$*"
        t="${t#"${t%%[![:space:]]*}"}"
        t="${t%"${t##*[![:space:]]}"}"
        printf '%s\n' "$t"
        ;;
    join)
        sep="${1:-}"
        if [ $# -gt 0 ]; then shift; fi
        out=""
        first=1
        for word in "$@"; do
            if [ "$first" -eq 1 ]; then
                out="$word"
                first=0
            else
                out="$out$sep$word"
            fi
        done
        printf '%s\n' "$out"
        ;;
    slug)
        printf '%s\n' "$*" |
            tr '[:upper:]' '[:lower:]' |
            sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' -e 's/-$//'
        ;;
    pad)
        width="${1:-0}"
        if [ $# -gt 0 ]; then shift; fi
        text="$*"
        while [ "${#text}" -lt "$width" ]; do
            text=" $text"
        done
        printf '%s\n' "$text"
        ;;
    reverse)
        printf '%s\n' "$*" | awk '{
            n = length($0)
            out = ""
            for (i = n; i > 0; i--)
                out = out substr($0, i, 1)
            print out
        }'
        ;;
    strip)
        chars="${1:-}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s\n' "$*" | tr -d "$chars"
        ;;
    title)
        printf '%s\n' "$*" | awk '{
            for (i = 1; i <= NF; i++)
                $i = toupper(substr($i, 1, 1)) tolower(substr($i, 2))
            print
        }'
        ;;
    nospace)
        printf '%s\n' "$*" | tr -s '[:space:]' ' ' | sed -e 's/ $//'
        ;;
    wrap)
        width="${1:-80}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s\n' "$*" | fold -s -w "$width"
        ;;
    indent)
        n="${1:-2}"
        if [ $# -gt 0 ]; then shift; fi
        pad=""
        i=0
        while [ "$i" -lt "$n" ]; do
            pad="${pad} "
            i=$((i + 1))
        done
        printf '%s\n' "$*" | sed -e "s|^|${pad}|"
        ;;
    words)
        printf '%s\n' "$*" | wc -w | tr -d ' '
        ;;
    lines)
        if [ -z "$*" ]; then
            printf '0\n'
        else
            printf '%s\n' "$*" | wc -l | tr -d ' '
        fi
        ;;
    head)
        n="${1:-1}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s\n' "$*" | head -n "$n"
        ;;
    tail)
        n="${1:-1}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s\n' "$*" | tail -n "$n"
        ;;
    unique)
        printf '%s\n' "$*" | sort -u
        ;;
    sortlines)
        printf '%s\n' "$*" | sort
        ;;
    csv-join)
        sep="${1:-,}"
        if [ $# -gt 0 ]; then shift; fi
        out=""
        first=1
        for cell in "$@"; do
            case "$cell" in
                *"$sep"* | *'"'*) cell="\"$(printf '%s' "$cell" | sed -e 's/"/""/g')\"" ;;
            esac
            if [ "$first" -eq 1 ]; then out="$cell"; first=0; else out="${out}${sep}${cell}"; fi
        done
        printf '%s\n' "$out"
        ;;
    replace)
        find="${1:-}"
        with="${2:-}"
        if [ $# -ge 2 ]; then shift 2; else shift $#; fi
        if [ -z "$find" ]; then
            printf '%s\n' "$*"
        else
            printf '%s\n' "$*" | sed -e "s|${find}|${with}|g"
        fi
        ;;
    camel)
        printf '%s\n' "$*" | awk '{
            out = ""
            for (i = 1; i <= NF; i++) {
                w = tolower($i)
                if (i == 1) out = out w
                else out = out toupper(substr(w, 1, 1)) substr(w, 2)
            }
            print out
        }'
        ;;
    kebab)
        printf '%s\n' "$*" | awk '{
            out = ""
            for (i = 1; i <= NF; i++) {
                if (i > 1) out = out "-"
                out = out tolower($i)
            }
            print out
        }'
        ;;
    snake)
        printf '%s\n' "$*" | awk '{
            out = ""
            for (i = 1; i <= NF; i++) {
                if (i > 1) out = out "_"
                out = out tolower($i)
            }
            print out
        }'
        ;;
    capitalize)
        printf '%s\n' "$*" | awk '{
            s = $0
            if (length(s) == 0) { print ""; exit }
            print toupper(substr(s, 1, 1)) tolower(substr(s, 2))
        }'
        ;;
    swapcase)
        printf '%s\n' "$*" | awk '{
            s = $0
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c ~ /[a-z]/) out = out toupper(c)
                else if (c ~ /[A-Z]/) out = out tolower(c)
                else out = out c
            }
            print out
        }'
        ;;
    initials)
        printf '%s\n' "$*" | awk '{
            out = ""
            for (i = 1; i <= NF; i++) out = out toupper(substr($i, 1, 1))
            print out
        }'
        ;;
    starts-with)
        prefix="${1:-}"
        if [ $# -gt 0 ]; then shift; fi
        case "$*" in
            "$prefix"*) printf 'yes\n' ;;
            *) printf 'no\n' ;;
        esac
        ;;
    ends-with)
        suffix="${1:-}"
        if [ $# -gt 0 ]; then shift; fi
        case "$*" in
            *"$suffix") printf 'yes\n' ;;
            *) printf 'no\n' ;;
        esac
        ;;
    contains)
        needle="${1:-}"
        if [ $# -gt 0 ]; then shift; fi
        case "$*" in
            *"$needle"*) printf 'yes\n' ;;
            *) printf 'no\n' ;;
        esac
        ;;
    is-empty)
        if [ -z "$*" ]; then printf 'yes\n'; else printf 'no\n'; fi
        ;;
    is-number)
        case "$*" in
            ''|*[!0-9.-]*) printf 'no\n' ;;
            *) printf 'yes\n' ;;
        esac
        ;;
    split)
        sep="${1:-,}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s\n' "$*" | awk -v s="$sep" '{
            n = length(s)
            rest = $0
            while (length(rest) > 0) {
                p = index(rest, s)
                if (p == 0) { print rest; break }
                print substr(rest, 1, p - 1)
                rest = substr(rest, p + n)
            }
        }'
        ;;
    default)
        fallback="${1:-}"
        if [ $# -gt 0 ]; then shift; fi
        if [ -z "$*" ]; then printf '%s\n' "$fallback"; else printf '%s\n' "$*"; fi
        ;;
    take)
        n="${1:-1}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s\n' "$*" | awk -v n="$n" '{
            out = ""
            c = 0
            for (i = 1; i <= NF && c < n; i++) {
                if (c > 0) out = out " "
                out = out $i
                c++
            }
            print out
        }'
        ;;
    drop)
        n="${1:-1}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s\n' "$*" | awk -v n="$n" '{
            out = ""
            for (i = n + 1; i <= NF; i++) {
                if (out != "") out = out " "
                out = out $i
            }
            print out
        }'
        ;;
    reverse-words)
        printf '%s\n' "$*" | awk '{
            out = ""
            for (i = NF; i >= 1; i--) {
                if (out != "") out = out " "
                out = out $i
            }
            print out
        }'
        ;;
    unique-words)
        printf '%s\n' "$*" | tr -s '[:space:]' '\n' | sed '/^$/d' | sort -u
        ;;
    count-char)
        needle="${1:-}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s' "$*" | awk -v n="$needle" '{
            if (length(n) == 0) { print 0; exit }
            c = 0
            for (i = 1; i <= length($0); i++) if (substr($0, i, 1) == n) c++
            print c
        }'
        ;;
    sum)
        printf '%s\n' "$*" | awk '{ t = 0; for (i = 1; i <= NF; i++) t += $i; print t }'
        ;;
    max)
        printf '%s\n' "$*" | awk 'NF {
            if (!seen || $1 > m) m = $1
            seen = 1
            for (i = 2; i <= NF; i++) if ($i > m) m = $i
        }
        END { if (seen) print m }'
        ;;
    min)
        printf '%s\n' "$*" | awk 'NF {
            if (!seen || $1 < m) m = $1
            seen = 1
            for (i = 2; i <= NF; i++) if ($i < m) m = $i
        }
        END { if (seen) print m }'
        ;;
    abs)
        printf '%s\n' "$*" | awk '{ print ($1 < 0 ? -$1 : $1) }'
        ;;
    round)
        printf '%s\n' "$*" | awk '{
            if ($1 < 0) printf "%d\n", -int(-$1 + 0.5)
            else printf "%d\n", int($1 + 0.5)
        }'
        ;;
    even)
        printf '%s\n' "$*" | awk '{ print ($1 % 2 == 0 ? "yes" : "no") }'
        ;;
    odd)
        printf '%s\n' "$*" | awk '{ print ($1 % 2 != 0 ? "yes" : "no") }'
        ;;
    ordinal)
        printf '%s\n' "$*" | awk '{
            n = $1
            if (n % 100 >= 11 && n % 100 <= 13) { print n "th"; exit }
            if (n % 10 == 1) print n "st"
            else if (n % 10 == 2) print n "nd"
            else if (n % 10 == 3) print n "rd"
            else print n "th"
        }'
        ;;
    pluralize)
        count="${1:-1}"
        if [ $# -gt 0 ]; then shift; fi
        singular="${1:-}"
        if [ $# -gt 0 ]; then shift; fi
        plural="${1:-${singular}s}"
        if [ "$count" -eq 1 ]; then
            printf '%s %s\n' "$count" "$singular"
        else
            printf '%s %s\n' "$count" "$plural"
        fi
        ;;
    center)
        width="${1:-40}"
        if [ $# -gt 0 ]; then shift; fi
        t="$*"
        len=${#t}
        if [ "$len" -ge "$width" ]; then
            printf '%s\n' "$t"
            exit 0
        fi
        left=$(((width - len) / 2))
        i=0
        while [ "$i" -lt "$left" ]; do
            printf ' '
            i=$((i + 1))
        done
        printf '%s\n' "$t"
        ;;
    truncate)
        width="${1:-80}"
        if [ $# -gt 0 ]; then shift; fi
        t="$*"
        if [ "${#t}" -le "$width" ]; then
            printf '%s\n' "$t"
            exit 0
        fi
        printf '%s...\n' "$(printf '%s' "$t" | cut -c1-"$width")"
        ;;
    mask)
        keep="${1:-1}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s\n' "$*" | awk -v k="$keep" '{
            s = $0
            n = length(s)
            if (n <= 2 * k) {
                for (i = 1; i <= n; i++) printf "*"
                print ""
                exit
            }
            out = ""
            for (i = 1; i <= n; i++) {
                c = substr(s, i, 1)
                if (i <= k || i > n - k) out = out c
                else out = out "*"
            }
            print out
        }'
        ;;
    squeeze)
        printf '%s\n' "$*" | awk '{
            s = $0
            out = ""
            prev = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c != prev) out = out c
                prev = c
            }
            print out
        }'
        ;;
    urlencode)
        printf '%s\n' "$*" | sed -e 's/ /%20/g' -e 's/?/%3F/g' -e 's/&/%26/g' \
            -e 's/=/%3D/g' -e 's/#/%23/g' -e 's/+/%2B/g'
        ;;
    number-lines)
        printf '%s\n' "$*" | awk '{ printf "%d. %s\n", NR, $0 }'
        ;;
    bullet)
        marker="${1:-- }"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s\n' "$*" | sed -e "s|^|${marker}|"
        ;;
    dedent)
        printf '%s\n' "$*" | sed -e 's/^[[:space:]]*//'
        ;;
    indent-right)
        n="${1:-2}"
        if [ $# -gt 0 ]; then shift; fi
        pad=""
        i=0
        while [ "$i" -lt "$n" ]; do
            pad="${pad} "
            i=$((i + 1))
        done
        printf '%s\n' "$*" | awk -v p="$pad" '{ print $0 p }'
        ;;
    chunk)
        n="${1:-2}"
        if [ $# -gt 0 ]; then shift; fi
        printf '%s' "$*" | fold -w "$n"
        ;;
    help | -h | --help)
        usage
        exit 0
        ;;
    *)
        printf 'astrycs: unknown command: %s\n' "$cmd" >&2
        usage >&2
        exit 1
        ;;
esac
